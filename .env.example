SMTP_FROM_NAME=E-Commerce API

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
SENTRY_DSN=

N8N_BASE_URL=http://localhost:5678
N8N_DB_NAME=
N8N_DB_USER=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=<a-long-random-secret-for-your-local-n8n>